:root,
html[data-theme="dark"],
body[data-theme="dark"] {
    --bg: #0A0F1E;
    --surface: #131B2E;
    --surface-alt: #1B2640;
    --border: #25314F;
    --text: #EAF0FB;
    --muted: #95A3C0;
    --faint: #5F6E8C;
    --accent: #4F9DFF;
    --accent-hover: #74B2FF;
    --good: #4ADE9A;
    --warn: #FBBF24;
    --danger: #FF6B7A;
    --danger-bg: #2A1622;
}

html[data-theme="light"],
body[data-theme="light"] {
    --bg: #EDF1F7;
    --surface: #FFFFFF;
    --surface-alt: #F1F5FB;
    --border: #DCE4F0;
    --text: #0E1A33;
    --muted: #5A6A87;
    --faint: #93A0B8;
    --accent: #2563EB;
    --accent-hover: #1D4FD0;
    --good: #0F9F6E;
    --warn: #B7791F;
    --danger: #D93A4F;
    --danger-bg: #FDECEF;
}

/* Force the complete application background */
html,
body {
    min-height: 100%;
    background: var(--bg) !important;
    color: var(--text) !important;
}

body {
    margin: 0;
    font-family: Inter, "Segoe UI", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
}

.app-shell {
    min-height: 100vh;
    color: var(--text) !important;
    background:
        radial-gradient(
            circle at 12% 8%,
            rgba(79,157,255,.10),
            transparent 28%
        ),
        radial-gradient(
            circle at 88% 15%,
            rgba(74,222,154,.045),
            transparent 24%
        ),
        var(--bg) !important;
}

.brand-name,
.city-name,
.temperature,
.condition,
.metric-value,
.day-name,
.day-high,
.hour-temp,
.section-heading h2,
.welcome-card h1,
.error-card h2 {
    color: var(--text);
}

.brand-tagline,
.country-name,
.feels-like,
.high-low,
.metric-label,
.metric-sub,
.day-date,
.day-condition,
.day-low,
.hour-time,
.hour-condition,
.section-note,
.forecast-location {
    color: var(--muted);
}

/* Dark welcome card must keep its text readable */
html[data-theme="dark"] .welcome-card,
body[data-theme="dark"] .welcome-card {
    color: #EAF0FB;
}

html[data-theme="dark"] .welcome-card h1,
body[data-theme="dark"] .welcome-card h1 {
    color: #FFFFFF;
}

html[data-theme="dark"] .welcome-card p,
body[data-theme="dark"] .welcome-card p {
    color: #95A3C0;
}

html[data-theme="dark"] .welcome-eyebrow,
body[data-theme="dark"] .welcome-eyebrow {
    color: #4F9DFF;
}

/* Dark controls */
html[data-theme="dark"] .search-box,
body[data-theme="dark"] .search-box {
    color: #EAF0FB;
}

html[data-theme="dark"] #cityInput,
body[data-theme="dark"] #cityInput {
    color: #EAF0FB;
    background: #131B2E;
    border-color: #25314F;
}

html[data-theme="dark"] #cityInput::placeholder,
body[data-theme="dark"] #cityInput::placeholder {
    color: #5F6E8C;
}

html[data-theme="dark"] .recent-label,
body[data-theme="dark"] .recent-label {
    color: #5F6E8C;
}

html[data-theme="dark"] .recent-chip,
body[data-theme="dark"] .recent-chip {
    color: #95A3C0;
    background: #131B2E;
    border-color: #25314F;
}

/* Light mode */
html[data-theme="light"] .welcome-card,
body[data-theme="light"] .welcome-card {
    color: #0E1A33;
}

html[data-theme="light"] .welcome-card h1,
body[data-theme="light"] .welcome-card h1 {
    color: #0E1A33;
}

html[data-theme="light"] .welcome-card p,
body[data-theme="light"] .welcome-card p {
    color: #5A6A87;
}

html[data-theme="light"] .welcome-eyebrow,
body[data-theme="light"] .welcome-eyebrow {
    color: #2563EB;
}
