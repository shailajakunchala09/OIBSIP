@'
/* =========================================================
   SKYPULSE WEB — PREMIUM DESKTOP MATCH
   Matches the current templates/index.html structure
   ========================================================= */

:root {
    --bg: #0A0F1E;
    --surface: #131B2E;
    --surface-alt: #1B2640;
    --border: #25314F;
    --text: #EAF0FB;
    --muted: #95A3C0;
    --faint: #5F6E8C;
    --accent: #4F9DFF;
    --accent-hover: #74B2FF;
    --good: #4ADE9A;
    --warn: #FBBF24;
    --danger: #FF6B7A;
    --danger-bg: #2A1622;
    --radius-lg: 28px;
    --radius-md: 20px;
    --radius-sm: 14px;
    --shadow: 0 20px 55px rgba(0,0,0,.24);
}

* {
    box-sizing: border-box;
}

html {
    min-height: 100%;
    background: var(--bg);
}

body {
    margin: 0;
    min-height: 100vh;
    color: var(--text);
    background:
        radial-gradient(circle at 12% 8%, rgba(79,157,255,.10), transparent 28%),
        radial-gradient(circle at 88% 15%, rgba(74,222,154,.045), transparent 24%),
        var(--bg);
    font-family: Inter, "Segoe UI", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
}

button,
input {
    font: inherit;
}

button {
    -webkit-tap-highlight-color: transparent;
}

.app-shell {
    width: min(1240px, calc(100% - 48px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 24px 0 30px;
}

/* =========================================================
   TOP BAR
   ========================================================= */

.topbar {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 26px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
}

.brand-mark {
    width: 46px;
    height: 46px;
    flex: 0 0 46px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: linear-gradient(145deg, #4F9DFF, #1B4FD6);
    box-shadow: 0 10px 25px rgba(37,99,235,.28);
    color: white;
    font-size: 23px;
    font-weight: 800;
}

.brand-copy {
    min-width: 0;
}

.brand-name {
    font-size: 18px;
    line-height: 1.05;
    font-weight: 850;
    letter-spacing: -.4px;
}

.brand-tagline {
    margin-top: 4px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .2px;
}

.top-controls {
    display: flex;
    align-items: center;
    gap: 8px;
}

.local-clock {
    color: var(--muted);
    font-size: 12px;
    font-weight: 650;
    margin-right: 6px;
    white-space: nowrap;
}

.unit-toggle {
    height: 38px;
    padding: 3px;
    display: flex;
    align-items: center;
    gap: 2px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface);
}

.unit-btn {
    height: 30px;
    min-width: 35px;
    padding: 0 9px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 12px;
    font-weight: 800;
}

.unit-btn.active {
    color: #fff;
    background: var(--accent);
    box-shadow: 0 5px 15px rgba(79,157,255,.24);
}

.icon-button {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    transition: .18s ease;
}

.icon-button:hover {
    color: var(--text);
    border-color: rgba(79,157,255,.55);
    background: var(--surface-alt);
    transform: translateY(-1px);
}

/* =========================================================
   SEARCH
   ========================================================= */

.search-section {
    margin-bottom: 24px;
}

.search-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
}

.search-box {
    position: relative;
    flex: 1;
    min-width: 0;
}

.search-icon {
    position: absolute;
    left: 17px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--faint);
    pointer-events: none;
    font-size: 16px;
}

#cityInput {
    width: 100%;
    height: 48px;
    padding: 0 46px;
    border: 1px solid var(--border);
    border-radius: 14px;
    outline: none;
    color: var(--text);
    background: rgba(19,27,46,.92);
    font-size: 13px;
    font-weight: 600;
    transition: .18s ease;
}

#cityInput::placeholder {
    color: var(--faint);
}

#cityInput:focus {
    border-color: rgba(79,157,255,.78);
    box-shadow: 0 0 0 4px rgba(79,157,255,.10);
}

.clear-search {
    position: absolute;
    right: 10px;
    top: 50%;
    width: 30px;
    height: 30px;
    transform: translateY(-50%);
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
}

.clear-search:hover {
    background: var(--surface-alt);
    color: var(--text);
}

.search-actions {
    display: flex;
    gap: 10px;
}

.primary-button,
.secondary-button {
    height: 48px;
    padding: 0 19px;
    border-radius: 14px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
    transition: .18s ease;
}

.primary-button {
    border: 1px solid rgba(79,157,255,.45);
    background: var(--accent);
    color: #fff;
    box-shadow: 0 10px 25px rgba(37,99,235,.20);
}

.primary-button:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
}

.secondary-button {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
}

.secondary-button:hover {
    border-color: rgba(79,157,255,.50);
    background: var(--surface-alt);
    transform: translateY(-1px);
}

.search-error {
    min-height: 20px;
    padding: 7px 4px 0;
    color: var(--danger);
    font-size: 12px;
    font-weight: 650;
}

.recent-row {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 8px;
    overflow-x: auto;
    scrollbar-width: none;
}

.recent-row::-webkit-scrollbar {
    display: none;
}

.recent-label {
    flex: 0 0 auto;
    color: var(--faint);
    font-size: 11px;
    font-weight: 750;
}

.recent-list {
    display: flex;
    gap: 7px;
}

.recent-chip {
    flex: 0 0 auto;
    padding: 7px 11px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    font-size: 11px;
    font-weight: 700;
}

.recent-chip:hover {
    color: var(--text);
    border-color: rgba(79,157,255,.45);
}

/* =========================================================
   STATES
   ========================================================= */

.welcome-card,
.loading-card,
.error-card {
    position: relative;
    overflow: hidden;
    min-height: 330px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
        radial-gradient(circle at 80% 15%, rgba(79,157,255,.14), transparent 28%),
        linear-gradient(145deg, #151F35, #0F172A);
    box-shadow: var(--shadow);
}

.welcome-card {
    padding: 52px;
}

.welcome-icons {
    display: flex;
    gap: 9px;
    margin-bottom: 26px;
}

.welcome-icons > * {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: rgba(255,255,255,.065);
    border: 1px solid rgba(255,255,255,.09);
}

.welcome-eyebrow,
.loading-eyebrow,
.error-eyebrow {
    color: var(--accent);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 1.5px;
}

.welcome-card h1 {
    max-width: 620px;
    margin: 11px 0 14px;
    font-size: clamp(34px, 5vw, 60px);
    line-height: .98;
    letter-spacing: -2.6px;
}

.welcome-card p {
    max-width: 640px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
}

.welcome-tips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 25px;
}

.welcome-tips > * {
    padding: 9px 12px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 10px;
    color: var(--muted);
    background: rgba(255,255,255,.045);
    font-size: 11px;
    font-weight: 700;
}

.loading-card {
    display: grid;
    place-items: center;
    padding: 44px;
    text-align: center;
}

.loading-spinner {
    width: 44px;
    height: 44px;
    margin-bottom: 18px;
    border: 3px solid rgba(255,255,255,.10);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

.loading-copy {
    color: var(--muted);
    margin-top: 9px;
    font-size: 13px;
}

.loading-skeletons {
    width: min(620px, 90%);
    margin-top: 25px;
}

.loading-skeletons > * {
    height: 12px;
    margin: 10px 0;
    border-radius: 99px;
    background: linear-gradient(90deg, #18243A, #243553, #18243A);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
}

.loading-skeletons > *:nth-child(2) {
    width: 78%;
}

.loading-skeletons > *:nth-child(3) {
    width: 58%;
}

.error-card {
    display: grid;
    place-items: center;
    padding: 45px;
    text-align: center;
    border-color: rgba(255,107,122,.20);
    background:
        radial-gradient(circle at 50% 20%, rgba(255,107,122,.10), transparent 30%),
        #151522;
}

.error-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    margin-bottom: 15px;
    border-radius: 18px;
    background: var(--danger-bg);
    color: var(--danger);
    font-size: 24px;
}

.error-card h2 {
    margin: 9px 0 8px;
    font-size: 23px;
}

.error-card p {
    max-width: 560px;
    margin: 0 0 22px;
    color: var(--muted);
    line-height: 1.6;
    font-size: 13px;
}

/* =========================================================
   DASHBOARD HERO
   ========================================================= */

#weatherDashboard {
    display: block;
}

.hero-card {
    position: relative;
    min-height: 292px;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid rgba(255,255,255,.13);
    background:
        radial-gradient(circle at 84% 18%, rgba(255,255,255,.14), transparent 22%),
        linear-gradient(135deg, #1D5FB8, #0B7C8F);
    box-shadow: 0 25px 65px rgba(0,0,0,.26);
}

.hero-stars,
.hero-rain {
    position: absolute;
    inset: 0;
    pointer-events: none;
}

.hero-stars {
    opacity: .8;
    background-image:
        radial-gradient(circle at 15% 25%, rgba(255,255,255,.6) 0 1px, transparent 2px),
        radial-gradient(circle at 35% 12%, rgba(255,255,255,.5) 0 1px, transparent 2px),
        radial-gradient(circle at 65% 28%, rgba(255,255,255,.5) 0 1px, transparent 2px),
        radial-gradient(circle at 78% 12%, rgba(255,255,255,.55) 0 1px, transparent 2px);
}

.hero-content {
    position: relative;
    z-index: 2;
    min-height: 292px;
    padding: 25px 30px 21px;
    display: flex;
    flex-direction: column;
}

.hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.weather-status {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 11px;
    border: 1px solid rgba(255,255,255,.20);
    border-radius: 999px;
    background: rgba(255,255,255,.10);
    color: rgba(255,255,255,.92);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .7px;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
}

.favorite-button {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.20);
    border-radius: 12px;
    background: rgba(255,255,255,.10);
    color: rgba(255,255,255,.80);
    cursor: pointer;
    font-size: 18px;
    transition: .18s ease;
}

.favorite-button:hover {
    background: rgba(255,255,255,.17);
    transform: scale(1.04);
}

.favorite-button.active {
    color: #FFC53D;
}

.hero-location {
    margin-top: 19px;
}

.city-name {
    font-size: 27px;
    line-height: 1.05;
    font-weight: 850;
    letter-spacing: -.8px;
    color: #fff;
}

.country-name {
    margin-top: 4px;
    color: rgba(255,255,255,.68);
    font-size: 11px;
    font-weight: 700;
}

.hero-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

.hero-temperature {
    display: flex;
    align-items: flex-start;
    color: #fff;
}

.temperature {
    font-size: clamp(66px, 8vw, 84px);
    line-height: .9;
    font-weight: 850;
    letter-spacing: -5px;
}

.temperature-unit {
    margin-top: 9px;
    margin-left: 6px;
    font-size: 17px;
    font-weight: 800;
    opacity: .78;
}

.hero-details {
    min-width: 205px;
}

.feels-like {
    color: rgba(255,255,255,.68);
    font-size: 11px;
    font-weight: 650;
}

.condition {
    margin-top: 5px;
    color: #fff;
    font-size: 16px;
    font-weight: 800;
}

.high-low {
    display: flex;
    gap: 12px;
    margin-top: 7px;
    color: rgba(255,255,255,.76);
    font-size: 11px;
    font-weight: 700;
}

.hero-icon-area {
    width: 150px;
    height: 150px;
    display: grid;
    place-items: center;
    flex: 0 0 150px;
}

#heroWeatherIcon {
    width: 130px;
    height: 130px;
    display: grid;
    place-items: center;
    font-size: 92px;
    line-height: 1;
    filter: drop-shadow(0 12px 20px rgba(0,0,0,.18));
}

#heroWeatherIcon img {
    width: 130px;
    height: 130px;
    object-fit: contain;
}

.hero-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding-top: 9px;
    border-top: 1px solid rgba(255,255,255,.10);
    color: rgba(255,255,255,.62);
    font-size: 10px;
    font-weight: 650;
}

/* =========================================================
   METRICS
   ========================================================= */

.metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 14px;
}

.metric-card {
    min-height: 124px;
    padding: 17px;
    display: flex;
    align-items: center;
    gap: 13px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
    box-shadow: 0 10px 30px rgba(0,0,0,.10);
    transition: .18s ease;
}

.metric-card:hover {
    border-color: rgba(79,157,255,.35);
    transform: translateY(-2px);
}

.metric-icon {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: rgba(79,157,255,.10);
    color: var(--accent);
    font-size: 18px;
}

.metric-content {
    min-width: 0;
}

.metric-label {
    color: var(--muted);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: .7px;
    text-transform: uppercase;
}

.metric-value {
    margin-top: 5px;
    color: var(--text);
    font-size: 17px;
    line-height: 1.15;
    font-weight: 850;
}

.metric-sub {
    margin-top: 4px;
    color: var(--faint);
    font-size: 10px;
    font-weight: 650;
}

/* =========================================================
   FORECAST SECTIONS
   ========================================================= */

.forecast-section {
    margin-top: 26px;
}

.section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 12px;
}

.section-heading h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 850;
    letter-spacing: -.25px;
}

.section-note {
    color: var(--faint);
    font-size: 10px;
    font-weight: 650;
}

.hourly-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
}

.hour-card {
    min-height: 172px;
    padding: 16px 13px;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface);
    transition: .18s ease;
}

.hour-card:hover {
    border-color: rgba(79,157,255,.35);
    transform: translateY(-2px);
}

.hour-time {
    color: var(--muted);
    font-size: 10px;
    font-weight: 750;
}

.hour-icon {
    height: 55px;
    display: grid;
    place-items: center;
    margin: 7px 0 4px;
    font-size: 34px;
}

.hour-icon img {
    width: 52px;
    height: 52px;
    object-fit: contain;
}

.hour-temp {
    color: var(--text);
    font-size: 19px;
    font-weight: 850;
}

.hour-condition {
    margin-top: 4px;
    color: var(--muted);
    font-size: 9px;
    font-weight: 650;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hour-pop {
    margin-top: 9px;
    color: var(--accent);
    font-size: 9px;
    font-weight: 750;
}

.daily-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
}

.day-card {
    min-height: 222px;
    padding: 17px;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--surface);
    transition: .18s ease;
}

.day-card:hover {
    border-color: rgba(79,157,255,.35);
    transform: translateY(-2px);
}

.day-card.today {
    border-color: rgba(79,157,255,.42);
    background:
        radial-gradient(circle at 85% 15%, rgba(79,157,255,.12), transparent 35%),
        var(--surface);
}

.day-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.day-name {
    color: var(--text);
    font-size: 12px;
    font-weight: 850;
}

.day-date {
    margin-top: 3px;
    color: var(--faint);
    font-size: 9px;
    font-weight: 650;
}

.today-badge {
    padding: 5px 7px;
    border-radius: 7px;
    color: #fff;
    background: var(--accent);
    font-size: 8px;
    font-weight: 850;
    text-transform: uppercase;
}

.day-icon {
    height: 65px;
    display: grid;
    place-items: center;
    margin: 8px 0 2px;
    font-size: 40px;
}

.day-icon img {
    width: 58px;
    height: 58px;
    object-fit: contain;
}

.day-condition {
    color: var(--muted);
    font-size: 9px;
    font-weight: 650;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.day-temps {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin-top: 8px;
}

.day-high {
    color: var(--text);
    font-size: 18px;
    font-weight: 850;
}

.day-low {
    color: var(--faint);
    font-size: 12px;
    font-weight: 700;
}

.day-range {
    height: 5px;
    margin-top: 10px;
    overflow: hidden;
    border-radius: 99px;
    background: var(--surface-alt);
}

.day-range-fill {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #4F9DFF, #74B2FF);
}

.day-pop {
    margin-top: 9px;
    color: var(--accent);
    font-size: 9px;
    font-weight: 750;
}

.forecast-location {
    color: var(--faint);
    font-size: 10px;
    font-weight: 650;
}

/* =========================================================
   FOOTER
   ========================================================= */

.app-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 28px 3px 5px;
    color: var(--faint);
    font-size: 10px;
    font-weight: 650;
}

.app-footer a {
    color: var(--muted);
}

/* =========================================================
   UTILITIES / JS HIDDEN STATE
   ========================================================= */

[hidden] {
    display: none !important;
}

.is-hidden {
    display: none !important;
}

/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

@keyframes shimmer {
    0% {
        background-position: 200% 0;
    }
    100% {
        background-position: -200% 0;
    }
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.hero-card,
.metric-card,
.hour-card,
.day-card {
    animation: fadeUp .35s ease both;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1080px) {
    .app-shell {
        width: min(100% - 32px, 1000px);
    }

    .hourly-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .daily-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 820px) {
    .topbar {
        align-items: flex-start;
    }

    .local-clock {
        display: none;
    }

    .search-row {
        flex-wrap: wrap;
    }

    .search-box {
        flex-basis: 100%;
    }

    .search-actions {
        width: 100%;
    }

    .search-actions .primary-button,
    .search-actions .secondary-button {
        flex: 1;
    }

    .metrics-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-main {
        gap: 10px;
    }

    .hero-icon-area {
        width: 110px;
        height: 110px;
        flex-basis: 110px;
    }

    #heroWeatherIcon,
    #heroWeatherIcon img {
        width: 100px;
        height: 100px;
    }
}

@media (max-width: 600px) {
    .app-shell {
        width: calc(100% - 22px);
        padding-top: 14px;
    }

    .topbar {
        margin-bottom: 18px;
    }

    .brand-tagline {
        display: none;
    }

    .top-controls {
        gap: 5px;
    }

    .welcome-card {
        padding: 32px 25px;
    }

    .welcome-card h1 {
        font-size: 37px;
        letter-spacing: -1.7px;
    }

    .hero-card,
    .hero-content {
        min-height: 0;
    }

    .hero-content {
        padding: 21px;
    }

    .hero-main {
        align-items: flex-end;
        flex-wrap: wrap;
        padding-top: 10px;
    }

    .hero-details {
        order: 3;
        flex-basis: 100%;
    }

    .hero-icon-area {
        margin-left: auto;
    }

    .metrics-grid,
    .daily-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hourly-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 4px;
    }

    .app-footer {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (max-width: 390px) {
    .metrics-grid,
    .daily-grid {
        grid-template-columns: 1fr;
    }

    .search-actions {
        flex-direction: column;
    }

    .temperature {
        font-size: 62px;
    }
}
'@ | Set-Content ".\static\style.css" -Encoding UTF8/* =========================================================
