# Copy this file to .env and fill in your own values.
# The .env file is listed in .gitignore and must never be uploaded to GitHub.

# OpenWeatherMap API key - https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Email account used only for the voice email feature.
# Use a test account, and for Gmail use a 16 character App Password
# (not your normal account password).
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# SMTP server settings. The defaults below work for Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
